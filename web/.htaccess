# VULN: Exposing .git directory and sensitive files
# A secure .htaccess would deny access to these

# VULN: Allowing directory listing
Options +Indexes

# VULN: Exposing PHP errors
php_flag display_errors on
php_flag display_startup_errors on

# VULN: No security headers
# Should include:
# Header set X-Frame-Options "DENY"
# Header set X-Content-Type-Options "nosniff"
# Header set X-XSS-Protection "1; mode=block"

# VULN: Overly permissive CORS already set in PHP
